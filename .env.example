# ==============================================================================
# SUNDOWNER 2026 — BACKEND CONFIGURATION
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local example: mongodb://127.0.0.1:27017/sundowner2026
# Cloud MongoDB Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/sundowner2026?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sundowner2026

# SMTP Email Configuration (For sending confirmed VIP passes with QR codes to attendees)
# For Gmail:
# 1. Set SMTP_USER to your Gmail address (e.g., yourname@gmail.com)
# 2. Go to Google Account > Security > 2-Step Verification > App passwords
# 3. Generate an App Password for "Mail" and paste the 16-letter password into SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sundowner 2026 <no-reply@sundowner2026.com>

